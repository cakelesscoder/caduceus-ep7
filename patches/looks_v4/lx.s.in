/* looks_v4 (patches/looks_v4; ep7-firmware, our own code). docs/LOOK_FORMAT_V4.md "LOOKS.BIN v4".
 *
 * LOOKS.BIN v4 = the v3 file with header +4 = 4, +32 = CRC-32 of the extension, +36 = 16 (extension record length), then
 * n x 16-byte extension records after the n v3 records: +0 base curve (slot +53, 0..7), +1..+6 colour mix (slot +54..+59,
 * s8 -64..64), +7..+15 zero. Header CRC (+16): bytes 0..15 then 20..63+64n, the v3 rule over the v3 part as the file has it.
 *
 *   lx_h1  <- jmp at fm_load's `mov d0,d3; mov d3,d1; and 63,d1` after ftell (5 B). d0 = file size, (4,sp) handle.
 *            (12,sp) = 0 (v3). Only a size 64 + 80 n (n 1..32) can be v4: then the header is read into L (fseek SET 0,
 *            fread 64) and must say version 4, n, payload 64 n, extension length 16. Yes: (12,sp) = 1, d3 = 64 + 64 n
 *            (the v3 part) -> jmp to fm_load's `mov d3,(8,sp)`, so fm_load reads only the v3 part into L. Anything else:
 *            the three instructions replayed, jmp back (a v3 file: stock I/O whenever its size is not 64 + 80 n).
 *   lx_h2  <- jmp at fm_load's `mov d0,d2; mov (4,sp),a0; call fclose` after fread (10 B). With (12,sp) = 1 and the whole
 *            v3 part read: lx_ext. Its block (or nothing) goes to (12,sp). Then the displaced instructions, jmp back.
 *   lx_ext    malloc(520) (class 1), +4 = P, fread 16 n bytes to +8, their CRC = L+32, every record in range, compacted to
 *            8 B per look (curve, mix x 6, 0 = slot +60) at +8 + 8 j, then +0 'EP7H'. Any miss: free, 0.
 *   lx_chk <- the jmp at fm_load's `call fm_check` (was jmp ls_chk). (12,sp) != 0: the v4 header CRC must hold, then L's
 *            header becomes v3 (+4 = 3, +32..37 = 0, CRC rewritten), so ls_sc, fm_check and every other reader of L see
 *            a v3 file; a bad CRC leaves L as read and fm_check rejects it. Then ls_sc and fm_check as ls_chk did. fm_check
 *            accepted and a block: P+872 = block; rejected and a block: free. jmp fm_load's `cmp 0,d0` with fm_check's d0.
 *   lx_pick <- sl_pick's tail jmp (was lh_pick): lh_pk, lx_pk, jmp ls_pick (lh_pick's two steps with lx_pk between).
 *   lx_pk     lh_pk's checks (COLOR k < 4, the real P, its L) and P+872 a class-1 block with 'EP7H' and back pointer P: a
 *            library look (pos 1..n) gets its 8 B at slot +53..+60. Own / Stock, no block, any miss: nothing (lh_pk has
 *            cleared +53..+59 for a library look, or put the snapshot back for Own / Stock, as before).
 * Stores: L's header (heap, through a3), the block (heap, through a0 / a2 / a1), P+872 and slot +53..+60 (heap P), the
 * frame word (12,sp) of fm_load and the stack. No absolute stores, no mul / div, no setlb / Lcc.
 */
 .am33_2
 .text
 .global _start
_start:

 .set FL_MAGIC, {lmagic}
 .set FF_MAGIC, {fmagic}
 .set LX_MAGIC, {xmagic}

/* CRC-32 of the file at a3 (d3 bytes) as fm_check computes it -> d0. Uses d0, d1, a0. */
 .macro FCRC
 mov -1,d0
 mov a3,a0
 mov 16,d1
 call ep7_fm_crc,[d2,d3],8
 mov a3,a0
 add 20,a0
 mov d3,d1
 add -20,d1
 call ep7_fm_crc,[d2,d3],8
 not d0
 .endm

/* ---------------------------------------------------------------- fm_load after ftell */
lx_h1:                            /* d0 = size, a2 = P, a3 = L, (4,sp) handle; d2 / d3 not live yet */
 clr d1
 mov d1,(12,sp)                   /* v3 */
 mov d0,(8,sp)                    /* fm_load writes (8,sp) again before it reads it */
 mov d0,d1
 add -144,d1
 cmp 2481,d1
 bcc h1_v3                        /* not 144..2624 */
 add 80,d1                        /* d1 = size - 64 */
1:
 cmp 80,d1
 bcs h1_v3
 add -80,d1
 bne 1b
 mov (4,sp),a0                    /* 64 + 80 n: read the header */
 clr d0
 mov 2,d1                         /* SET */
 call ep7_fseek,[d2,d3,a2,a3],20
 cmp 0,d0
 bne h1_v3
 mov a3,a0
 mov 1,d0
 mov 64,d1
 mov (4,sp),a1
 call ep7_fread,[d2,d3,a2,a3],24
 cmp 64,d0
 bne h1_v3
 movhu (4,a3),d0
 cmp 4,d0
 bne h1_v3
 movhu (36,a3),d0
 cmp 16,d0
 bne h1_v3
 movhu (24,a3),d0                 /* n */
 cmp 0,d0
 beq h1_v3
 cmp 33,d0
 bcc h1_v3
 mov d0,d1
 asl 6,d1                         /* 64 n */
 mov (12,a3),d2
 cmp d1,d2
 bne h1_v3
 mov d1,d3
 add 64,d3                        /* d3 = the v3 part */
 asl 4,d0
 add d3,d0                        /* 64 + 80 n */
 mov (8,sp),d1
 cmp d0,d1
 bne h1_v3
 mov 1,d0
 mov d0,(12,sp)                   /* v4 */
 jmp ep7_fl_v4                    /* fm_load: mov d3,(8,sp); fseek SET 0; fread d3 bytes */
h1_v3:
 mov (8,sp),d0
 mov d0,d3                        /* displaced */
 mov d3,d1                        /* displaced */
 and 63,d1                        /* displaced: its flags for fm_load's beq */
 jmp ep7_fl_v3

/* ---------------------------------------------------------------- fm_load after fread */
lx_h2:                            /* d0 = bytes read, (8,sp) = bytes asked, a2 = P, a3 = L */
 mov d0,d2                        /* displaced */
 mov (12,sp),d0
 cmp 1,d0
 bne h2_close
 mov (8,sp),d3
 cmp d3,d2
 bne h2_close
 mov (4,sp),a1
 call lx_ext,[d2,d3,a2,a3],20
 cmp 0,d0
 beq h2_close
 mov d0,(12,sp)                   /* the block */
h2_close:
 mov (4,sp),a0                    /* displaced */
 call ep7_fclose,[d2,a2,a3],16    /* displaced */
 jmp ep7_fl_h2

lx_ext:                           /* a1 = handle, d3 = 64 + 64 n, a2 = P, a3 = L -> d0 = block or 0 */
 mov a1,d2                        /* d2 = handle */
 mov 520,d0
 call ep7_malloc,[],4
 cmp 0,a0
 beq e_none
 mov a0,d0
 btst 3,d0
 bne e_free
 add {npool1},d0
 cmp {elim},d0
 bcc e_free
 clr d0
 mov d0,(a0)                      /* no magic until every check passed */
 mov a2,(4,a0)
 mov a0,a2                        /* a2 = block from here on */
 add -64,d3
 lsr 2,d3                         /* d3 = 16 n */
 add 8,a0
 mov 1,d0
 mov d3,d1
 mov d2,a1
 call ep7_fread,[d2,d3,a2,a3],24
 cmp d3,d0
 bne e_free2
 mov -1,d0
 mov a2,a0
 add 8,a0
 mov d3,d1
 call ep7_fm_crc,[d2,d3],8
 not d0
 mov (32,a3),d1
 cmp d1,d0
 bne e_free2
 mov a2,a1                        /* records: curve 0..7, mix -64..64, +7..15 zero */
 add 8,a1
 mov d3,d2
2:
 movbu (a1),d0
 cmp 8,d0
 bcc e_free2
 mov 1,d1
3:
 movbu (d1,a1),d0
 extb d0
 add 64,d0
 cmp 129,d0
 bcc e_free2
 inc d1
 cmp 7,d1
 bne 3b
4:
 movbu (d1,a1),d0
 cmp 0,d0
 bne e_free2
 inc d1
 cmp 16,d1
 bne 4b
 add 16,a1
 add -16,d2
 bne 2b
 mov a2,a1                        /* compact: 16 B -> 8 B per look, ascending (the target never passes the source) */
 add 8,a1
 mov a1,a0
 lsr 4,d3                         /* d3 = n */
5:
 clr d1
6:
 movbu (d1,a1),d0
 movbu d0,(d1,a0)
 inc d1
 cmp 7,d1
 bne 6b
 clr d0
 movbu d0,(7,a0)                  /* slot +60 = 0 (checked zero above) */
 add 16,a1
 add 8,a0
 add -1,d3
 bne 5b
 mov LX_MAGIC,d0
 mov d0,(a2)
 mov a2,d0
 ret [d2,d3,a2,a3],20
e_free2:
 mov a2,a0
e_free:
 call ep7_free,[],4
e_none:
 clr d0
 ret [d2,d3,a2,a3],20

/* ---------------------------------------------------------------- fm_load's fm_check call */
lx_chk:                           /* a3 = L, d3 = 64 + 64 n, a2 = P */
 mov (12,sp),d0
 cmp 0,d0
 beq 1f
 call lx_hdr,[d2,d3,a2,a3],20
1:
 call ep7_ls_sc,[d2,d3,a2,a3],20
 call ep7_fm_check,[d2,d3,a2,a3],20
 mov (12,sp),a0
 mov a0,d1
 cmp 2,d1
 bcs 3f                           /* no block */
 cmp 0,d0
 bne 2f
 mov a0,(872,a2)                  /* accepted: publish the block */
 jmp ep7_fm_after
2:
 call ep7_free,[],4
 mov 1,d0
3:
 jmp ep7_fm_after

lx_hdr:                           /* v4 header: CRC, then the v3 header */
 FCRC
 mov (16,a3),d1
 cmp d1,d0
 bne 9f
 mov 3,d0
 movbu d0,(4,a3)
 clr d0
 mov d0,(32,a3)
 movhu d0,(36,a3)
 FCRC
 mov d0,(16,a3)
9:
 ret [d2,d3,a2,a3],20

/* ---------------------------------------------------------------- Film pick */
lx_pick:                          /* <- sl_pick's tail jmp: a2 = P, d3 = k */
 call ep7_lh_pk,[d2,d3,a2,a3],20
 call lx_pk,[d2,d3,a2,a3],20
 jmp ep7_ls_pick

lx_pk:
 cmp 4,d3
 bcc 9f
 call ep7_ap_p,[d2],8
 cmp 0,d0
 beq 9f
 mov a0,d0
 mov a2,d1                        /* d1 = P */
 cmp d1,d0
 bne 9f
 mov (1020,a2),d0
 cmp FF_MAGIC,d0
 bne 9f
 mov (1016,a2),a0
 mov a0,d0
 btst 3,d0
 bne 9f
 add {npool},d0
 cmp {llim},d0
 bcc 9f
 mov (2112,a0),d0
 cmp FL_MAGIC,d0
 bne 9f
 mov (2116,a0),d0
 cmp d1,d0
 bne 9f
 mov (872,a2),a1                  /* the block */
 mov a1,d0
 btst 3,d0
 bne 9f
 add {npool1},d0
 cmp {plim},d0
 bcc 9f
 mov (a1),d0
 cmp LX_MAGIC,d0
 bne 9f
 mov (4,a1),d0
 cmp d1,d0
 bne 9f
 movbu (2120,a0),d2               /* n */
 add d3,a0
 movbu (2121,a0),d0               /* pos */
 cmp 0,d0
 beq 9f                           /* Own */
 cmp d2,d0
 bhi 9f                           /* Stock (n + 1) */
 asl 3,d0
 add d0,a1                        /* a1 = block + 8 pos = look pos-1's 8 B */
 mov d3,d0
 asl 6,d0
 add a2,d0
 mov d0,a0                        /* a0 = P + 64k: slot +53 = (85,a0) */
 movbu (0,a1),d0
 movbu d0,(85,a0)
 movbu (1,a1),d0
 movbu d0,(86,a0)
 movbu (2,a1),d0
 movbu d0,(87,a0)
 movbu (3,a1),d0
 movbu d0,(88,a0)
 movbu (4,a1),d0
 movbu d0,(89,a0)
 movbu (5,a1),d0
 movbu d0,(90,a0)
 movbu (6,a1),d0
 movbu d0,(91,a0)
 movbu (7,a1),d0
 movbu d0,(92,a0)
9:
 ret [d2,d3,a2,a3],20
lx_end:
