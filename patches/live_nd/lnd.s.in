/* E-P7 1.1 Live ND inside Multiple Exposure, test n3 (ep7-firmware, our own code). docs/LIVE_ND.md "As built".
 * Number of Frames (sid 267) offers 3 and 4 (ND3 / ND4); the ME machinery reads those counts natively. n3 also
 * unlocks 267 in AP Multiple Exposure (its forced pair 267 = 2 is removed from the mode's preset block), so these
 * guards make an unlocked 0/1 read as 2 there, as stock AP Multiple Exposure always saw.
 *   lnd_kg <- rel32 of call {prop},[d2,d3],12 at 0x602a8378 (capture +24141 Auto Gain): 1 while frames >= 3
 *   lnd_n  <- rel32 of call {get},[],4 with d0 = 267 (ME on, ME controller, ME sequence parts)
 *   lnd_kn <- rel32 of call {prop},[d2,d3],12 at 0x602a838b (capture +24140 frames, key 0x1841)
 *   lnd_a  <- rel32 of call {appget},[d2,a2],24 with d0 = 267 (app layer)
 *   guard: in AP Multiple Exposure Off/1 -> 2 (stock AP ME frames); elsewhere ND3/ND4 -> 2 (ND is AP-only); 2f stock
 *   0.31n2: no burst-engine code (0.31n1's lnd_cap crashed Seq H; n8's lnd_cont was never reliable). One press = the stock
 *   custom self-timer: lnd_st <- rel32 of call {rget},[],4 at the 8 sid-469 reads and the timer start's 470 / 471 reads.
 *   While ND3/ND4 in AP ME and drive 3281 == 24 (Custom Self-timer): 469 -> N, 470 -> 5 (0.5 s), 471 -> 1 (1 s).
 *   n7: no continuous-drive change and no release latch. Continuous stays as AP Multiple Exposure's preset forces it (off),
 *   so ND3 / ND4 take one frame per press in every drive mode (camera on 0.30b7: n6's continuous route stalled after 2
 *   frames and the release latch turned that into a hang).
 * Miss paths run the stock getter with the stock arguments in the site's frame. No stores (the log part, lnd_log.s.in, writes only its own heap block), no mul/div/setlb.
 */
 .am33_2
 .text
 .global _start
_start:

lnd_kg:                           /* site: mov 0x1851,d0; mov 0,a0; clr d1; call {prop},[d2,d3],12 */
 call lnd_ap,[],4                 /* (0,sp) of the [d2,d3],12 frame is the nested return slot */
 bne 1f                           /* ND exists only in AP Multiple Exposure */
 mov 267,d0
 call {get},[],4
 cmp 3,d0
 bcs 1f
 mov 1,d0                         /* ND3 / ND4: Auto Gain On */
 ret [d2,d3],12
1:
 mov 0x1851,d0
 clr d1
 mov 0,a0
 jmp {prop}

lnd_ap:                           /* [],4 (call): Z set when sid 24 == 211 */
 mov 24,d0
 call {get},[],4
 cmp 211,d0
 ret [],4

lnd_ape:                          /* [],4 (call): d0 = 1 in AP Multiple Exposure (sid 24 == 211), else 0 */
 mov 24,d0
 call {get},[],4
 cmp 211,d0
 bne 1f
 mov 1,d0
 ret [],4
1:
 clr d0
 ret [],4

lnd_n:                            /* site: mov 267,d0; call {get},[],4 (frame [],4: no saved registers) */
 add -8,sp                        /* (0,sp) nested return slot, (4,sp) scratch */
 call lnd_ape,[],4
 mov d0,(4,sp)
 mov 267,d0
 call {get},[],4
 mov (4,sp),d1
 add 8,sp
 cmp 2,d0
 beq 9f                           /* 2f: stock everywhere */
 cmp 0,d1
 beq 3f
 cmp 2,d0                         /* AP Multiple Exposure: Off -> 2 (stock AP ME), ND3 / ND4 as is */
 bcc 9f
 mov 2,d0
 bra 9f
3:
 cmp 3,d0                         /* elsewhere: ND3 / ND4 -> 2 (ND is AP-only), Off as is */
 bcs 9f
 mov 2,d0
9:
 ret [],4

lnd_kn:                           /* site: mov 0x1841,d0; mov 0,a0; clr d1; call {prop},[d2,d3],12 (d2, d3 restored by ret) */
 call {prop},[d2,d3],12
 mov d0,d2
 call lnd_ape,[],4
 mov d0,d3
 mov d2,d0
 cmp 2,d0
 beq 9f                           /* 2f: stock everywhere */
 cmp 0,d3
 beq 3f
 cmp 2,d0                         /* AP Multiple Exposure: Off -> 2 (stock AP ME), ND3 / ND4 as is */
 bcc 9f
 mov 2,d0
 bra 9f
3:
 cmp 3,d0                         /* elsewhere: ND3 / ND4 -> 2 (ND is AP-only), Off as is */
 bcs 9f
 mov 2,d0
9:
 ret [d2,d3],12

lnd_a:                            /* site: mov 267,d0; call {appget},[d2,a2],24 (d2, a2 restored by ret) */
 call {appget},[d2,a2],24
 mov d0,d2
 call lnd_ape,[],4
 mov d0,a2
 mov d2,d0
 cmp 2,d0
 beq 9f                           /* 2f: stock everywhere */
 cmp 0,a2
 beq 3f
 cmp 2,d0                         /* AP Multiple Exposure: Off -> 2 (stock AP ME), ND3 / ND4 as is */
 bcc 9f
 mov 2,d0
 bra 9f
3:
 cmp 3,d0                         /* elsewhere: ND3 / ND4 -> 2 (ND is AP-only), Off as is */
 bcs 9f
 mov 2,d0
9:
 ret [d2,a2],24

lnd_nd:                           /* [],8 (call): d0 = N (3 / 4) while ND3 / ND4 in AP Multiple Exposure, else 0 */
 call lnd_ape,[],4
 cmp 0,d0
 beq 9f
 mov 267,d0
 call {get},[],4
 cmp 3,d0
 bcs 8f
 cmp 5,d0
 bcs 9f
8:
 clr d0
9:
 ret [],8

/*@st*/
lnd_ns:                           /* [d2],12 (call): d0 = N while ND3/ND4 in AP ME and the drive (3281) is Custom Self-timer (24), else 0 */
 call lnd_nd,[],8                 /* (0,sp) of the [d2],12 frame is the nested return slot */
 cmp 0,d0
 beq 9f
 mov d0,d2
 mov 3281,d0
 call {rget},[],4
 cmp 24,d0
 bne 8f
 mov d2,d0
 ret [d2],12
8:
 clr d0
9:
 ret [d2],12

lnd_st:                           /* site: mov 469|470|471,d0; call {rget},[],4 (frame [],4: no saved registers) */
 add -12,sp                       /* (0,sp) nested return slot, (4,sp) sid, (8,sp) N or 0 */
 mov d0,(4,sp)
 call lnd_ns,[d2],12
 mov d0,(8,sp)
 mov (4,sp),d0
 call {rget},[],4                 /* stock value */
 mov (8,sp),d1
 cmp 0,d1
 beq 9f                           /* not ND + Custom Self-timer: stock */
 mov (4,sp),a0
 cmp 469,a0
 bne 1f
 mov d1,d0                        /* custom self-timer frames = N */
 bra 9f
1:
 cmp 470,a0
 bne 2f
 mov 5,d0                         /* interval: 0.5 s, the validator's minimum */
 bra 9f
2:
 mov 1,d0                         /* 471, start delay: 1 s, the validator's minimum */
9:
 add 12,sp
 ret [],4
/*@endst*/

 .balign 4
lnd_end:
