/* Tinted halation on COLOR stills (patches/halation h4 = h2's halation, bit for bit, + h3's watchdog yields; was h1; ep7-firmware, our own code). docs/HALATION_RED.md §15.
 * Runs on the CPU grain route, at the Soft Focus blend hook (gc_gs), after the blend and before the grain:
 *   A  Y of every 2nd pixel on every 4th row: cell += max(0, Y - T) >> 2, saturating at 248, in a 64 x 64 px cell grid (u8);
 *   B  two [1 2 1] / 4 passes per axis; u = min(255, 21 v >> 3), g = (u (511 - u) >> 8) gmax >> 8 (a soft knee);
 *      coverage cap: a third of the cells or more with g >= 16 means no halation (daylight stays fast);
 *   C  per row with any glow: g per pixel pair, bilinear between cell centres; with w = 255 - Y:
 *      Y += w g dY >> 16 (each pixel), C0 += w0 g dC0 >> 16, C1 += w0 g dC1 >> 16 (clamped 0..255).
 * Pixel pair bytes: Y0 C0 Y1 C1. C0 / C1 = Cb / Cr is the guess the camera test checks (build --swap exchanges the tint columns).
 * Stage (h2): slot +52 = 1..4 is the Extras override (Off, Low, Med, High); 0 = the look's: effect_id +28 = 2 (tint 0 = red) or 1 with
 * tint +45 = 1..4, strength +29 1-2 Low, 3-4 Med, 5 High. A Film pick, Own or Stock resets +52 to 0. Tint: +45 1..4, else red.
 * Writes only the photo buffer, the stack, grain record +96 and our own malloc blocks.
 * hl_run is one frame split over four placements, joined by jmp (sp never changes between the pieces). */
 .set T_THR, {thr}

/* ------------------------------------------------------------------ .hlb: entries, hl_run P1 (checks, buffers) */
 .section .hlb,"ax"
/* hl_lvl: replaces gc_gs's `call gc_lvl,[d2,d3],16`, a0 = job -> d0 = grain level 1..3, 4 = halation only, 0 = stock; d1 = gc_lvl's guard.
 * h2: the word is tint << 4 | stage (1 Low, 2 Med, 3 High).
 * Leaves the halation word at grain record +96 (0 = none) for hl_grain. gc_lvl's guard 0x14 means the job checks passed. */
hl_lvl:
 mov a0,d3
 call gc_lvl,[d2,d3],16
 mov d0,d2
 mov d1,(4,sp)
 clr d0
 cmp 0x14,d1
 bne 1f
 mov d3,a0                        /* profile 1..4 -> slot */
 movbu (15488,a0),d0
 add -1,d0
 cmp 4,d0
 bcc 7f
 call ep7_tbl_idx,[d2,d3],8
 call hl_stg,[],0                 /* stage 0..3: the Extras override, or the look's */
 cmp 0,d0
 beq 7f
 mov d0,d1
 movbu (45,a0),d3                 /* tint 1..4, else red */
 add -1,d3
 cmp 4,d3
 bcs 3f
 clr d3
3:
 inc d3
 asl 4,d3
 or d1,d3
 mov d3,d0
 bra 1f
7:
 clr d0
1:
 mov d0,d3
 call gc_blk,[],8
 cmp 0,a1
 beq 8f
 movhu d3,(96,a1)
 mov d2,d0
 cmp 0,d0
 bne 9f
 cmp 0,d3
 beq 9f
 mov 4,d0
 bra 9f
8:
 mov d2,d0
9:
 mov (4,sp),d1
 ret [d2,d3],16

/* hl_grain: replaces gc_gs's `call gc_grain,[d2,d3,a2,a3],144` (same frame), a0 = 0x1000 record, d0 = level 1..4.
 * Halation first (film grain sits over the glow), then the grain for levels 1..3. */
hl_grain:
 mov a0,(4,sp)
 mov d0,(60,sp)
 call gc_blk,[],8
 cmp 0,a1
 beq 5f
 movhu (96,a1),d0
 cmp 0,d0
 beq 5f
 clr d1
 movhu d1,(96,a1)
 mov (4,sp),a0
 call hl_run,[d2,d3,a2,a3],96
5:
 mov (4,sp),a0
 mov (60,sp),d0
 cmp 4,d0
 bcc 6f
 jmp gc_grain
6:
 ret [d2,d3,a2,a3],144

/* hl_run: `call hl_run,[d2,d3,a2,a3],96`, a0 = record, d0 = tint << 4 | strength. Locals (the context for hl_row / hl_seg / hl_gpb):
 * (4) rec, (8) word, (12) W, (16) H, (20) bus, (24) pitch, (28) GW, (32) GH, (36) scratch, (40) grid, (44) Gp, (48) gmax, (52) tint row,
 * (56) cells (B) / y (C), (64) mode, (68) grid row (A) / t (C), (72) row 0, (76) row 1. Scratch (512 B): box temp (u16, n + 2). */
hl_run:
 mov a0,(4,sp)
 mov d0,(8,sp)
 clr d0                           /* (36) is written before any exit that frees */
 mov d0,(40,sp)
 mov d0,(44,sp)
 movhu (8,a0),d0
 cmp 0x0302,d0
 bne 99f
 movhu (20,a0),d0
 movhu (22,a0),d1
 or d1,d0
 bne 99f
 movhu (12,a0),d0
 mov d0,(12,sp)
 mov d0,d1
 add -64,d1
 cmp 8129,d1                      /* 64 <= W <= 8192, W % 4 == 0 */
 bcc 99f
 btst 3,d0
 bne 99f
 add 63,d0
 lsr 6,d0
 mov d0,(28,sp)
 movhu (10,a0),d1
 mov (12,sp),d0
 cmp d0,d1
 bcs 99f
 add d1,d1
 mov d1,(24,sp)
 movhu (14,a0),d2
 mov d2,(16,sp)
 mov d2,d0
 add -1,d0
 cmp 8192,d0                      /* 1 <= H <= 8192 */
 bcc 99f
 mov d2,d0
 add 63,d0
 lsr 6,d0
 mov d0,(32,sp)
 mul d2,d1                        /* pitch * H within the record's size */
 mov (72,a0),d0
 cmp d1,d0
 bcs 99f
 mov (a0),d0
 mov d0,(20,sp)
 add d0,d1                        /* d1 = end */
 cmp 0xa0000000,d0
 bcs 99f
 cmp 0xb0000000,d0
 bcc 2f
 cmp 0xb0000001,d1
 bcc 99f
 bra 3f
2:
 cmp 0xe0000001,d1
 bcc 99f
 cmp 0xc4000000,d0
 bcc 3f
 cmp 0xc0000001,d1
 bcc 99f
3:
 mov (8,sp),d0                    /* gmax and tint row */
 mov d0,d1
 and 15,d0
 mov hl_gm-1,a1
 movbu (d0,a1),d0
 mov d0,(48,sp)
 lsr 4,d1
 add -1,d1
 mov d1,d0
 add d1,d1
 add d0,d1
 asl2 d1
 mov hl_tint,a1
 add d1,a1
 mov a1,(52,sp)
 mov 512,d0                       /* buffers (uncached heap) */
 call ep7_malloc,[],4
 mov a0,(36,sp)
 cmp 0,a0
 beq 99f
 mov 4096,d0
 call ep7_malloc,[],4
 mov a0,(44,sp)
 cmp 0,a0
 beq 98f
 mov (28,sp),d0
 mov (32,sp),d3
 mul d0,d3
 mov d3,(56,sp)
 mov d3,d0
 call ep7_malloc,[],4
 mov a0,(40,sp)
 cmp 0,a0
 beq 98f
 jmp hl_pa
98:
 jmp hl_x98
99:
 ret [d2,d3,a2,a3],96

/* ------------------------------------------------------------------ .hlc: hl_run P2 (pass A), exit */
 .section .hlc,"ax"
hl_pa:                            /* a0 = grid, d3 = cells: clear it */
 clr d0
4:
 movbu d0,(a0)
 inc a0
 add -1,d3
 bne 4b
 mov d0,(64,sp)
 mov 2,d2
1:
 mov d2,d0
 lsr 6,d0
 mov (28,sp),d1
 mul d1,d0
 mov (40,sp),d1
 add d1,d0
 mov d0,(68,sp)
 mov d2,d0
 mov sp,a1
 call hl_row,[d2,d3,a2,a3],32
 cmp 0,d0
 bne 9f
 add 4,d2
 mov (16,sp),d1
 cmp d1,d2
 bcs 1b
 jmp hl_pb
9:
 jmp hl_x98
/* the common exit: free what was allocated */
hl_x98:
 mov sp,a2
 add 36,a2
 mov 3,d2
1:
 mov (a2),a0
 cmp 0,a0
 beq 2f
 call ep7_free,[],4
2:
 add 4,a2
 add -1,d2
 bne 1b
 ret [d2,d3,a2,a3],96


/* ------------------------------------------------------------------ .text: hl_run P3 (pass B), helpers */
 .text
hl_pb:
 clr d2                           /* rows */
1:
 mov d2,d0
 mov (28,sp),d1
 mul d1,d0
 mov (40,sp),a0
 add d0,a0
 mov (36,sp),a1
 mov 1,d1
 mov (28,sp),d0
 call hl_box,[d2,d3,a2,a3],32
 inc d2
 mov (32,sp),d0
 cmp d0,d2
 bcs 1b
 clr d2                           /* columns */
2:
 mov (40,sp),a0
 add d2,a0
 mov (36,sp),a1
 mov (28,sp),d1
 mov (32,sp),d0
 call hl_box,[d2,d3,a2,a3],32
 inc d2
 mov (28,sp),d0
 cmp d0,d2
 bcs 2b
 mov (40,sp),a0                   /* map, count */
 mov (56,sp),d3
 mov (48,sp),d2
 mov 0,a1
3:
 movbu (a0),d0
 mov d0,d1
 asl 2,d1
 add d0,d1
 asl 2,d1
 add d0,d1
 lsr 3,d1
 cmp 255,d1
 bls 4f
 mov 255,d1
4:
 mov 511,d0
 sub d1,d0
 mul d1,d0
 lsr 8,d0
 mul d2,d0
 lsr 8,d0
 cmp 16,d0
 bcs 5f
 inc a1
5:
 movbu d0,(a0)
 inc a0
 add -1,d3
 bne 3b
 mov a1,d0
 jmp hl_pc

/* hl_box: `call hl_box,[d2,d3,a2,a3],32`, a0 = u8 line, d0 = n, d1 = stride, a1 = temp (u16, n + 2): two [1 2 1] / 4 passes, zero beyond the ends */
hl_box:
 mov d0,(4,sp)
 mov d1,d2
 mov 2,d0
 mov d0,(8,sp)
1:
 mov a1,a2
 clr d0
 movhu d0,(a2)
 add 2,a2
 mov a0,a3
 mov (4,sp),d3
2:
 movbu (a3),d0
 movhu d0,(a2)
 add 2,a2
 add d2,a3
 add -1,d3
 bne 2b
 clr d0
 movhu d0,(a2)
 mov a1,a2
 mov a0,a3
 mov (4,sp),d3
3:
 movhu (a2),d0
 movhu (4,a2),d1
 add d1,d0
 movhu (2,a2),d1
 add d1,d1
 add d1,d0
 add 2,d0
 lsr 2,d0
 movbu d0,(a3)
 add 2,a2
 add d2,a3
 add -1,d3
 bne 3b
 mov (8,sp),d0
 add -1,d0
 mov d0,(8,sp)
 bne 1b
 ret [d2,d3,a2,a3],32

/* hl_li: `call hl_li,[],8`, d0 = cell column (clamped to 0..GW-1), a1 = context -> d0 = (64 r0 + (r1 - r0) t) >> 6. Uses d1, a0 */
hl_li:
 cmp 0,d0
 bge 1f
 clr d0
1:
 mov (28,a1),d1
 cmp d1,d0
 bcs 2f
 mov d1,d0
 add -1,d0
2:
 mov (72,a1),a0
 movbu (d0,a0),d1
 mov d1,(4,sp)
 mov (76,a1),a0
 movbu (d0,a0),d0
 sub d1,d0
 mov (68,a1),d1
 mul d1,d0
 mov (4,sp),d1
 asl 6,d1
 add d1,d0
 asr 6,d0
 ret [],8

/* hl_gpb: `call hl_gpb,[d2,d3,a2,a3],32` from hl_run (its locals at sp + 32). Gp[p] for the pixel pairs: segment k = 0..GW spans
 * pair positions 64 k - 32 .. 64 k + 32 between cells k - 1 and k (clamped); v = 64 a + (b - a) j, step 2 (b - a) per pair,
 * g = v >> 6; 16 pairs for k = 0 (from j = 32) and k = GW, 32 otherwise: 32 GW pairs. Local (4) k. */
hl_gpb:
 mov sp,a1
 add 32,a1
 mov (44,a1),a2
 clr d0
 mov d0,(4,sp)
1:
 mov (4,sp),d0
 add -1,d0
 call hl_li,[],8
 mov d0,d3                        /* a */
 mov (4,sp),d0
 call hl_li,[],8
 sub d3,d0
 mov d0,d1
 add d1,d1                        /* step */
 asl 6,d3
 mov d3,d0                        /* v */
 mov 32,d3
 mov (4,sp),d2
 cmp 0,d2
 bne 2f
 mov d1,d2
 asl 4,d2
 add d2,d0
 mov 16,d3
 mov (4,sp),d2
2:
 mov (28,a1),a0
 cmp a0,d2
 bne 3f
 mov 16,d3
3:
 mov d0,d2
 asr 6,d2
 movbu d2,(a2)
 inc a2
 add d1,d0
 add -1,d3
 bne 3b
 mov (4,sp),d0
 inc d0
 mov d0,(4,sp)
 mov (28,a1),d1
 cmp d1,d0
 bls 1b
 ret [d2,d3,a2,a3],32

/* hl_row: `call hl_row,[d2,d3,a2,a3],32`, d0 = row, a1 = context -> d0 = 0, or 1 if a window was refused. One lock per piece of row;
 * a row that crosses a 128 MB slice edge goes in two pieces (rows and edges are 4-byte aligned, so a pixel pair never splits). */
hl_row:
 mov a1,(4,sp)
 mov (24,a1),d1
 mul d1,d0
 mov (20,a1),d1
 add d1,d0
 mov d0,(8,sp)                    /* bus */
 mov (12,a1),d2                   /* W */
 mov d0,d1
 add d2,d1
 add d2,d1
 add -1,d1
 xor d0,d1
 lsr 27,d1
 bne 1f
 mov d2,d1
 mov 0,a0
 call hl_seg,[d2,d3,a2,a3],40
 bra 9f
1:
 and 0x07ffffff,d0
 mov 0x08000000,d3
 sub d0,d3                        /* bytes to the edge */
 mov d3,(12,sp)
 lsr 1,d3
 mov d3,d1
 mov (8,sp),d0
 mov 0,a0
 call hl_seg,[d2,d3,a2,a3],40
 cmp 0,d0
 bne 9f
 mov (4,sp),a1
 mov (12,sp),d0
 mov d0,d3
 lsr 1,d3
 mov d3,a0                        /* x0 */
 mov (12,a1),d1
 sub d3,d1
 mov (8,sp),d2
 add d2,d0
 call hl_seg,[d2,d3,a2,a3],40
9:
 ret [d2,d3,a2,a3],32

/* hl_seg: `call hl_seg,[d2,d3,a2,a3],40`, d0 = bus, d1 = pixels, a0 = x0, a1 = context -> d0 = 0 / 1. Locals (4) n, (8) x0, (12) ctx, (16) token, (20) restore */
hl_seg:
 mov d1,(4,sp)
 mov a0,(8,sp)
 mov a1,(12,sp)
 call gc_open,[d2,d3,a2,a3],32
 mov d0,(16,sp)
 mov d1,(20,sp)
 cmp 0,a0
 bne 1f
 mov (16,sp),d0
 call hl_unl,[d2],8
 mov 1,d0
 ret [d2,d3,a2,a3],40
1:
 add -0x40000000,a0
 mov (12,sp),a1
 mov (64,a1),d0
 cmp 0,d0
 bne 30f
 mov (68,a1),a1                   /* A: grid row; d1 = x, a2 = end x */
 mov (8,sp),d1
 mov (4,sp),a2
 add d1,a2
2:
 movbu (a0),d0
 add -T_THR,d0
 ble 3f
 lsr 2,d0
 mov d1,d2
 lsr 6,d2
 movbu (d2,a1),d3
 add d0,d3
 cmp 248,d3
 bls 4f
 mov 248,d3
4:
 movbu d3,(d2,a1)
3:
 add 4,a0
 add 2,d1
 cmp a2,d1
 bcs 2b
 bra 40f
30:
 mov (44,a1),a2                   /* C: a1 = Gp + x0 / 2, a2 = its end, a3 = tint row */
 mov (52,a1),a3
 mov (8,sp),d0
 lsr 1,d0
 mov a2,a1
 add d0,a1
 mov (4,sp),d0
 lsr 1,d0
 add a1,d0
 mov d0,a2
31:
 movbu (a1),d3
 inc a1
 cmp 0,d3
 beq 39f
 movbu (a0),d0                    /* Y0; d2 = w0 g */
 mov 255,d2
 sub d0,d2
 mul d3,d2
 mov (a3),d1
 mul d2,d1
 asr 16,d1
 add d1,d0
 movbu d0,(a0)
 movbu (2,a0),d1                  /* Y1 */
 mov 255,d0
 sub d1,d0
 mul d3,d0
 mov (a3),d1
 mul d1,d0
 asr 16,d0
 movbu (2,a0),d1
 add d0,d1
 movbu d1,(2,a0)
 mov (4,a3),d0                    /* C0 */
 mul d2,d0
 asr 16,d0
 movbu (1,a0),d1
 add d0,d1
 cmp 0,d1
 bge 32f
 clr d1
32:
 cmp 255,d1
 ble 33f
 mov 255,d1
33:
 movbu d1,(1,a0)
 mov (8,a3),d0                    /* C1 */
 mul d2,d0
 asr 16,d0
 movbu (3,a0),d1
 add d0,d1
 cmp 0,d1
 bge 34f
 clr d1
34:
 cmp 255,d1
 ble 35f
 mov 255,d1
35:
 movbu d1,(3,a0)
39:
 add 4,a0
 cmp a2,a1
 bcs 31b
40:
 mov (20,sp),d0
 cmp -1,d0
 bne 41f
 call ep7_flush,[d2,d3],16
 bra 42f
41:
 call ep7_modeset,[d2,d3,a2],20   /* flushes first */
42:
 mov (16,sp),d0
 call hl_unl,[d2],8
 clr d0
 ret [d2,d3,a2,a3],40

/* ------------------------------------------------------------------ .hlp (section 3): hl_run P4 (pass C) */
 .section .hlp,"ax"
hl_pc:                            /* d0 = cells with g >= 16: none, or 3 count > cells: no halation */
 cmp 0,d0
 beq 9f
 mov d0,d1
 add d0,d0
 add d1,d0
 mov (56,sp),d1
 cmp d1,d0
 bhi 9f
 mov 1,d0
 mov d0,(64,sp)
 clr d0
 mov d0,(56,sp)
1:
 clr d1                           /* y -> gy0, t (68), gy1; gy0 <= GH - 1 since y < H <= 64 GH */
 mov (56,sp),d0
 add -32,d0
 blt 2f
 mov d0,d1
 and 63,d1
 lsr 6,d0
 bra 3f
2:
 clr d0
3:
 mov d1,(68,sp)
 mov (32,sp),d1
 add -1,d1
 mov d0,d3
 inc d3
 cmp d1,d3
 bls 5f
 mov d1,d3
5:
 mov (28,sp),d1
 mul d1,d0
 mov (40,sp),a0
 add d0,a0
 mov a0,(72,sp)
 mul d1,d3
 mov (40,sp),a1
 add d3,a1
 mov a1,(76,sp)
 mov (28,sp),d3                   /* any glow in either cell row? */
 clr d0
6:
 movbu (a0),d1
 or d1,d0
 movbu (a1),d1
 or d1,d0
 inc a0
 inc a1
 add -1,d3
 bne 6b
 cmp 0,d0
 beq 8f
 call hl_gpb,[d2,d3,a2,a3],32
 mov (56,sp),d0
 mov sp,a1
 call hl_row,[d2,d3,a2,a3],32
 cmp 0,d0
 bne 9f
8:
 mov (56,sp),d0
 inc d0
 mov d0,(56,sp)
 mov (16,sp),d1
 cmp d1,d0
 bcs 1b
9:
 jmp hl_x98

/* ------------------------------------------------------------------ tables, at the end of .text */
 .text
 .balign 4
hl_tint:
{tint}
hl_gm:
 .byte {gmax}

/* ------------------------------------------------------------------ .hlf (h2): stage, flag hook, pick reset, labels */
 .section .hlf,"ax"
/* hl_stg: leaf (retf), a0 = slot entry (byte n at (n,a0)) -> d0 = stage 0..3. Uses d0, d1. hl_auto: the look's stage, ignoring +52 */
hl_stg:
 movbu (52,a0),d0
 cmp 0,d0
 beq hl_auto
 add -1,d0
 cmp 4,d0
 bcs 9f
 clr d0
9:
 retf [],0
hl_auto:
 movbu (28,a0),d1
 cmp 2,d1
 beq 2f
 cmp 1,d1
 bne 8f
 movbu (45,a0),d1
 cmp 0,d1
 beq 8f
2:
 movbu (45,a0),d1
 cmp 5,d1
 bcc 8f
 movbu (29,a0),d0                 /* strength 1..5 -> 1 1 2 2 3 */
 add -1,d0
 cmp 5,d0
 bcc 8f
 lsr 1,d0
 inc d0
 retf [],0
8:
 clr d0
 retf [],0

/* hl_flag: gc_flag's tail jmp (was jmp bloom_flag). a2 = params+12, a3 = capture. A COLOR still with a stage gets the Soft Focus flag 0x80,
 * so the blend hook (and the halation) runs; looks without bloom keep a neutral blend (bw_default 1024). Uses d0, d1, a0, a1 only. */
hl_flag:
 movhu (-2,a2),d0
 cmp 11,d0
 bne 9f
 movhu (-4,a2),d0
 cmp 0,d0
 bne 9f
 movbu ({cap_mode},a3),d0
 cmp 11,d0
 bne 9f
 movhu (194,a3),d0
 cmp 0x2001,d0
 beq 9f
 cmp 0x2006,d0
 beq 9f
 cmp 0x1008,d0
 beq 9f
 cmp 0x1006,d0
 beq 9f
 movbu ({cap_profile},a3),d0
 add -1,d0
 cmp 4,d0
 bcc 9f
 call ep7_tbl_idx,[d2,d3],8
 call hl_stg,[],0
 cmp 0,d0
 beq 9f
 mov (a2),d0
 or 128,d0
 mov d0,(a2)
9:
 jmp ep7_bloom_flag

/* hl_ua: u_apply (Film pick, Own, Stock), d0 = slot entry: the look's halation again (+52 = 0), then gc_ua */
hl_ua:
 mov d0,a0
 clr d1
 movbu d1,(52,a0)
 jmp ep7_gc_ua

 .section .hll,"a"
hl_lab:                           /* 13 B each; .hll */
 .asciz "11 Halo Off"
 .byte 0
 .asciz "11 Halo Low"
 .byte 0
 .asciz "11 Halo Med"
 .byte 0
 .asciz "11 Halo High"
 .section .hlf,"ax"
hl_xl:
 .asciz "Extras: 1-11 only"

/* ------------------------------------------------------------------ .hlx (h2, section 9): Extras sector 11 (index 10) = +52 */
 .section .hlx,"ax"
/* a2 = P + 64 slot, slot byte n at (32 + n, a2) */
hl_sg:                            /* ex_get, sector index >= 7 */
 cmp 10,d3
 beq 1f
 jmp ep7_sh_sg
1:
 mov a2,a0
 add 32,a0
 call hl_stg,[],0
 jmp ep7_g_val

hl_ss:                            /* ex_set, sector index >= 7: d1 = wheel value -> +52 = 1 + clamp(d1, 0, 3) */
 cmp 10,d3
 beq 1f
 jmp ep7_sh_ss
1:
 cmp 0,d1
 bge 2f
 clr d1
2:
 cmp 3,d1
 ble 3f
 mov 3,d1
3:
 inc d1
 movbu d1,(84,a2)
 jmp ep7_s_dirty

hl_su:                            /* ex_guide: d3 = sector index, a2 = text */
 cmp 10,d3
 beq 1f
 jmp ep7_sh_su
1:
 mov (8,sp),d0
 add d3,d0
 mov sp,a1
 add 4,a1
 calls ep7_ex_get
 cmp 0,d0
 bne 3f
 mov (4,sp),d1
 cmp 4,d1
 bcc 3f
 mov d1,d0                        /* 13 v */
 asl 2,d0
 add d1,d0
 asl 1,d0
 add d1,d0
 add d1,d0
 add d1,d0
 mov hl_lab,a2
 add d0,a2
 jmp ep7_q_put0
3:
 jmp ep7_q_out

hl_def:                           /* ex_default hit tail: d2 = 64 slot + sector, a2 = P, a1 = out. Sector 11 answers the look's stage */
 mov d2,d0
 and 63,d0
 cmp 10,d0
 beq 1f
 jmp ep7_sh_def
1:
 mov d2,d0
 and 0xc0,d0
 add d0,a2
 mov a2,a0
 add 32,a0
 call hl_auto,[],0
 mov d0,(a1)
 movm (sp),[d2,d3,a2]
 rets

/* ------------------------------------------------------------------ .hl6 (h3/h4, section 6): the yield helper */
 .section .hl6,"ax"
/* hl_unl: `call hl_unl,[d2],8`, d0 = lock token. Unlock, then every 32nd time sleep one tick (dly_tsk 1), so lower-priority tasks run:
 * the capture task (REC_MAIN, priority 0x36) otherwise starves SYS_WDT (0x37, kicks every 3 s, 10 s hardware timeout) for the whole
 * CPU pass. Used by the halation rows and by grain's gc_grain (its three unlock calls). Counter: grain record +100. Uses d0, d1, a0, a1.
 * Changes no pixel. */
hl_unl:
 call ep7_unlock,[d2],8
 call gc_blk,[],8
 cmp 0,a1
 beq 9f
 movbu (100,a1),d0
 inc d0
 movbu d0,(100,a1)
 and 31,d0
 bne 9f
 mov 1,d0
 call ep7_dly,[d2,a2,a3],16
9:
 ret [d2],8

