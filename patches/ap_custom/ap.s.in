 movbu (d2,a2),d0
 movbu d0,(d2,a3)
 inc d2
 cmp 1024,d2
 bne 1b
 mov ap_pbin,a0
 mov ep7_m_r,a1
 call ep7_fopen,[],4
 cmp 0,a0
 beq l_free
 mov a0,(4,sp)
 mov a0,a1
 mov a3,a0
 add {fb},a0
 mov 1,d0
 mov 97,d1
 call ep7_fread,[d2,d3,a2,a3],24
 mov d0,d2
 mov (4,sp),a0
 call ep7_fclose,[d2,a2,a3],16
 cmp 96,d2
 bne l_free
 mov a3,a1
 add {fb},a1
 mov (a1),d0
 cmp {vfile},d0
 bne l_free
 mov (4,a1),d0
 cmp 1,d0
 bne l_free
 mov (8,a1),d0
 cmp 80,d0
 bne l_free
 mov a1,a0
 add 16,a0
 mov 80,d0
 mov -1,d1
 call ep7_crc,[d2,d3],8
 not d1
 mov a3,a1
 add {fb},a1
 mov (12,a1),d0
 cmp d0,d1
 bne l_free
 mov a1,a0                        /* H/L +0..23, WB +26/27 -7..7; sat +33..44, B/W +47/48 -5..5; +52..63 zero; name ends NUL */
 add 16,a0
 mov 24,d0
 mov 7,d1
 call ep7_mv_rng,[d2,d3],8
 cmp 0,d0
 bne l_free
 mov a3,a0
 add {fb}+16+26,a0
 mov 2,d0
 mov 7,d1
 call ep7_mv_rng,[d2,d3],8
 cmp 0,d0
 bne l_free
 mov a3,a0
 add {fb}+16+33,a0
 mov 12,d0
 mov 5,d1
 call ep7_mv_rng,[d2,d3],8
 cmp 0,d0
 bne l_free
 mov a3,a0
 add {fb}+16+47,a0
 mov 2,d0
 mov 5,d1
 call ep7_mv_rng,[d2,d3],8
 cmp 0,d0
 bne l_free
 mov a3,a0
 add {fb}+16+52,a0
 mov 12,d0
 clr d1
 call ep7_mv_rng,[d2,d3],8
 cmp 0,d0
 bne l_free
 mov a3,a1
 add {fb}+95,a1
 movbu (a1),d0
 cmp 0,d0
 bne l_free
 clr d2                           /* slot -> COLOR4's row, name -> COLOR4's */
2:
 mov a3,a1
 add d2,a1
 add {fb}+16,a1
 movbu (a1),d0
 mov a3,a0
 add d2,a0
 add 224,a0
 movbu d0,(a0)
 inc d2
 cmp 64,d2
 bne 2b
 clr d2
3:
 mov a3,a1
 add d2,a1
 add {fb}+80,a1
 movbu (a1),d0
 mov a3,a0
 add d2,a0
 add 592,a0
 movbu d0,(a0)
 inc d2
 cmp 16,d2
 bne 3b
 mov {nmagic},d0
 mov d0,(672,a3)
 clr d0
 mov d0,({pend},a3)               /* pending (one aligned word; the file buffer is done with) */
 clr d0
 movbu d0,({dirty},a3)
 mov (1020,a3),d0                 /* LOOKS.BIN loaded: P3 gets its own table L3 (Film checks L+2116 == P) */
 cmp {fmagic},d0
 bne l_pub
 mov {lsize},d0
 call ep7_malloc,[],4
 cmp 0,a0
 bne 4f
 clr d0
 mov d0,(1020,a3)                 /* no memory: AP slot without a Film page */
 bra l_pub
4:
 mov (1016,a2),a1
 clr d2
5:
 movbu (d2,a1),d0
 movbu d0,(d2,a0)
 inc d2
 cmp {lsize},d2
 bne 5b
 mov a3,(2116,a0)
 mov a0,(1016,a3)
 clr d0
 movbu d0,(2124,a0)
 movbu d0,(2128,a0)
 mov a0,a1                        /* a name that is a colour look's resumes on it, as fm_load */
 add 112,a1
 add 592,a3
 clr d3
6:
 movbu (-2,a1),d0
 btst 1,d0
 beq 9f
 clr d1
7:
 movbu (d1,a1),d0
 movbu (d1,a3),d2
 cmp d2,d0
 bne 9f
 inc d1
 cmp 16,d1
 bne 7b
 mov d3,d0
