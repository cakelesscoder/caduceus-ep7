 bcs 6b
8:
 add -592,a3
l_pub:
 add -4,sp
 mov {all0},d0
 call ep7_sget,[],4
 add 4,sp
 mov d0,({va},a3)
 add -4,sp
 mov {all1},d0
 call ep7_sget,[],4
 add 4,sp
