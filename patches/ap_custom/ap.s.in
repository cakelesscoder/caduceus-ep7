 mov {vmagic},d0
 mov d0,({vm},a3)
 mov a3,({ap3},a2)
 mov {amagic},d0
 mov d0,({am},a2)                 /* last: the pipeline may use the slot from here */
 bra l_out
l_free:
 mov a3,a0
 call ep7_free,[],4
l_out:
 ret [d2,d3,a2,a3],24

/* ap_save: a2 = P3 -> 1 ok, 3 / 4 fail, 2 no memory. As mv_save: .NEW verified, old -> .BAK, .BIN verified */
ap_save:
 mov 2048,d0
 call ep7_malloc,[],4
 mov a0,a3
 mov 2,d0
 cmp 0,a3
 beq v_ret
 mov {vfile},d0
 mov d0,(a3)
 mov 1,d0
 mov d0,(4,a3)
 mov 80,d0
 mov d0,(8,a3)
 clr d2
1:
 mov a2,a0
 add d2,a0
 add 224,a0
 movbu (a0),d0
 mov a3,a0
 add d2,a0
 add 16,a0
 movbu d0,(a0)
 inc d2
 cmp 64,d2
 bne 1b
 clr d2
2:
 mov a2,a0
 add d2,a0
 add 592,a0
 movbu (a0),d0
 mov a3,a0
 add d2,a0
 add 80,a0
 movbu d0,(a0)
 inc d2
 cmp 16,d2
 bne 2b
 clr d0
 movbu d0,(95,a3)
 mov a3,a0
 add 16,a0
 mov 80,d0
 mov -1,d1
 call ep7_crc,[d2,d3],8
 not d1
 mov d1,(12,a3)
 mov ap_pnew,a0
 mov a3,a1
 mov 96,d0
 call ep7_wfile,[d2,d3,a2,a3],28
 mov d0,d3
 mov 3,d0
 cmp 0,d3
 bne v_free
 mov ap_pbin,a0
 mov ep7_m_r,a1
 call ep7_fopen,[],4
 cmp 0,a0
 beq 4f
 mov a0,a2
 mov a3,a0
