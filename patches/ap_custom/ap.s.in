/* ap_boot: from ap_pre on a half-press, `call ap_boot,[d2,d3,a2],16`. Uses d0, d1, a0, a1.
 * The BUNDLES loader spent its attempt and failed (0xFFFF): reset it to 0, up to {retries} times this boot, so its own gate tries again
 * (a card still mounting after a crash-restart). The first half-press with a valid P this boot: clear P's marks (DRAM keeps an earlier
 * session's heap bytes). Byte {boot} (.bss, boot-cleared): bit 0 marks cleared, bits 4-7 retries. */
ap_boot:
 movhu ({state}),d0               /* BUNDLES loader spent its attempt and failed (0xFFFF): allow it {retries} more, one per half-press */
 cmp 0xffff,d0
 bne 3f
 mov {boot},a0
 movbu (a0),d1
 mov d1,d0
 lsr 4,d0
 cmp {retries},d0
 bcc 3f
 add 16,d1
 movbu d1,(a0)
 clr d0
 mov {state},a0
 movhu d0,(a0)                    /* 0 = not attempted: the loader's own gate decides on the next half-press */
 bra 9f
3:
 mov {boot},a0                    /* .bss byte, 0 at every power-on. Bit 0: the first half-press with a valid P this boot; bits 4-7: retries */
 movbu (a0),d0
 btst 1,d0
 bne 9f
 call ap_P,[d2],8
 cmp 1,d0
 bne 9f
 clr d0                           /* P is a fresh malloc: heap bytes from an earlier session (DRAM keeps them) must not pass as our marks */
 mov d0,({vt},a0)
 mov d0,({vm},a0)
 mov d0,({am},a0)
 mov d0,({atr},a0)
 mov {boot},a0
 movbu (a0),d0
 or 1,d0
 movbu d0,(a0)
9:
 ret [d2,d3,a2],16

ap_xg:                            /* facade GetValue (CALLS: d0 id, a1 out, (0,sp) return) */
 add -12,sp
 mov d0,(4,sp)
 mov mdr,d0
 mov d0,(8,sp)
 mov (4,sp),d0
 call ap_xb,[d2,d3,a2],16
 cmp 1,d0
 bne 1f
 cmp 0,a1
 beq 1f
 clr d0
 mov d0,(a1)
 mov (8,sp),d0
 mov d0,mdr
 add 12,sp
 clr d0
 rets
1:
 mov (8,sp),d0
 mov d0,mdr
 mov (4,sp),d0
 add 12,sp
 jmp ep7_mv_get

ap_xs:                            /* `call ap_xs,[d2,d3,a2],16` at the GUI setter: d0 id, d1 value */
 add -12,sp
 mov d0,(4,sp)
 mov mdr,d0
 mov d0,(8,sp)
 mov (4,sp),d0
 call ap_xb,[d2,d3,a2],16
 mov d0,d2
 mov (8,sp),d0
 mov d0,mdr
 mov (4,sp),d0
 add 12,sp
 cmp 1,d2
 bne 1f
 clr d0                           /* blocked: no write */
 ret [d2,d3,a2],16
1:
 jmp ep7_mv_set

/* ap_wlog: from ap_lbl (frame as mv_lb, d1 / a0 / a1 saved): "Muted" in movie (sid 44 == 1) -> kind 5 "8-BIT LOG" through mv_lb's copy loop. */
ap_wlog:
 mov 44,d0
 call ep7_sget,[],4
 cmp 1,d0
 beq 1f
 jmp ap_lr
1:
 mov 5,d0
 movhu d0,(a3)
 clr d0
 movhu d0,(26,a3)                 /* the NUL after 9 characters (text at +8) */
 mov a3,a1
 add 8,a1
 mov ap_tlog,a0
 jmp ep7_lb_copy

ap_end:
ap_tlog:
 .asciz "8-BIT LOG"
ap_pbin:
 .asciz "C:\\EP7MOD\\AP.BIN"
ap_pnew:
 .asciz "C:\\EP7MOD\\AP.NEW"
ap_pbak:
 .asciz "C:\\EP7MOD\\AP.BAK"
ap_data_end:
