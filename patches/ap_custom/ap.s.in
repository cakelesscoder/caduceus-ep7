/* E-P7 1.1 AP Custom: the mode dial's AP position, picture mode Vivid = its own INFO Custom slot (ep7-firmware, our own code). docs/AP_CUSTOM.md.
 * P3 = third 1024 B heap block, a copy of P with the AP slot in COLOR4's row (+224) and name (+592), loaded from EP7MOD/AP.BIN (MOVIE.BIN format).
 * P: +{am} 'EP7A' (published), +{ap3} P3, +{atr} 'EP7U' (load tried). P3: +{vm} 'EP7V', +{vp} P3, +{vh} P's handle, +{va} ALL values: the movie wheel code
 * (mv_sw / mv_get / mv_set / mv_exit / Film / Extras) then works on P3 unchanged while the state word holds P3's handle.
 * AP = sid 44 != 1 and sid 24 in 14, 209..216 (the values for which stock 0x602b6b4f forces sid 1645, the normal list). Pipeline: also 0x9481 == 1 (Vivid).
 *   ap_get   <- getter rel32 at the capture population (pm, COLOR profile, 12 x S), sc_prop and wb_prop: pm 1 -> 11, profile -> 4, S -> P3
 *   ap_tx    <- jmp at tbl_x (0x6055e7e7, end of tbl_idx / tbl_off): a COLOR4 row offset -> P3's row
 *   ap_key / ap_msg / ap_s / ap_tb  <- live view record path, in front of mv_key / sh_msg / mv_s / mv_tbl
 *   ap_lc    <- Live Control INFO, in front of mv_lc;  ap_ccg <- mv_get's Color Creator guard;  ap_la / ap_lb2 <- label builders, in front of mv_la / mv_lc2
 *   ap_pre   <- sd_back jmp (save a dirty P3 as AP.BIN, then mv_trig);  ap_post <- mv_trig's tail jmp (first half-press: load AP.BIN, then ed_trig)
 * Every miss runs the previous owner with the registers it had. All reads but the heap blocks, the state word swap (as mv_lc) and the card files.
 */
 .am33_2
 .text
 .global _start
_start:
 .macro SAVE5
 add -24,sp
 mov d0,(4,sp)
 mov d1,(8,sp)
 mov a0,(12,sp)
 mov a1,(16,sp)
 mov mdr,d0
 mov d0,(20,sp)
 mov (4,sp),d0
 .endm
 .macro REST5
 mov (20,sp),d0
 mov d0,mdr
 mov (4,sp),d0
 mov (8,sp),d1
 mov (12,sp),a0
 mov (16,sp),a1
 add 24,sp
 .endm
 .macro HV d, a, miss
 add -1,\d
 cmp {lim},\d
 bcc \miss
 btst 3,\d
 bne \miss
 mov \d,\a
 add {pool},\a
 mov (\a),\d
 cmp {bmagic},\d
 bne \miss
 .endm

/* ap_P: -> d0 = 1, a0 = P (the unswapped block, also while P2 or P3 is swapped in), else d0 = 0. `call ap_P,[d2],8`. Uses d0, a0. */
ap_P:
 movhu ({state}),d2
 HV d2,a0,9f
 mov ({vm},a0),d2
 cmp {vmagic},d2
 bne 2f
 mov ({vp},a0),d2
 cmp a0,d2
 bne 2f
 mov ({vh},a0),d2                 /* swapped: P's handle */
 HV d2,a0,9f
2:
 mov 1,d0
 ret [d2],8
9:
 clr d0
 ret [d2],8

/* ap_q: a0 = P -> d0 = 1, a0 = P3 when published and sound, else d0 = 0. `call ap_q,[d2],8` */
ap_q:
 mov ({am},a0),d2
 cmp {amagic},d2
 bne 9f
 mov ({ap3},a0),a0
 mov a0,d2
 add {neg_pool},d2
 cmp {lim},d2
 bcc 9f
 btst 3,d2
 bne 9f
 mov (a0),d2
 cmp {bmagic},d2
 bne 9f
 mov ({vm},a0),d2
 cmp {vmagic},d2
 bne 9f
 mov ({vp},a0),d2
 cmp a0,d2
 bne 9f
 mov 1,d0
 ret [d2],8
9:
 clr d0
 ret [d2],8

/* ap_mode: -> d0 = 1, a0 = P3 when the AP slot is loaded and the dial is on AP, else d0 = 0. `call ap_mode,[d2,d3,a2],16`. Clobbers d0, d1, a0, a1. */
ap_mode:
 call ap_P,[d2],8
 cmp 1,d0
 bne 9f
 call ap_q,[d2],8
 cmp 1,d0
 bne 9f
 mov a0,a2
 add -4,sp
 mov {k44},d0
 clr d1
 mov 0,a0
 call ep7_getter,[d2,d3],12
 add 4,sp
 cmp 1,d0
 beq 9f
 add -4,sp
 mov {k24},d0
 clr d1
 mov 0,a0
 call ep7_getter,[d2,d3],12
 add 4,sp
 cmp 14,d0
 beq 1f
 add -209,d0
 cmp 8,d0
 bcc 9f
1:
 mov a2,a0
 mov 1,d0
 ret [d2,d3,a2],16
9:
 clr d0
 ret [d2,d3,a2],16

/* ap_on: ap_mode and picture mode 0x9481 == 1 (Vivid). Same contract. */
ap_on:
 call ap_mode,[d2,d3,a2],16
 cmp 1,d0
 bne 9f
 mov a0,a2
 add -4,sp
 mov 38017,d0
 clr d1
 mov 0,a0
 call ep7_getter,[d2,d3],12
 add 4,sp
 cmp 1,d0
 bne 9f
 mov a2,a0
 ret [d2,d3,a2],16
9:
 clr d0
 ret [d2,d3,a2],16

/* ap_val: d2 = key, d3 = idx -> d0 = 1, d1 = the AP answer, else d0 = 0. `call ap_val,[d2,d3,a2],16`. Clobbers d0, d1, a0, a1. */
ap_val:
 cmp 38017,d2
 beq 1f
 cmp 63153,d2
 beq 1f
 cmp 63210,d2
 bne 9f
 cmp 12,d3
 bcc 9f
1:
 call ap_on,[d2,d3,a2],16
 cmp 1,d0
 bne 9f
 mov 11,d1
 cmp 38017,d2
 beq 8f
 mov 4,d1
 cmp 63153,d2
 beq 8f
 add 257,a0
 movbu (d3,a0),d1
 extb d1
8:
 mov 1,d0
 ret [d2,d3,a2],16
9:
 clr d0
 ret [d2,d3,a2],16

/* ap_get: the getter's place (site frame [d2,d3],12; d0 key, d1 idx, a0 = 0 at every site, build-checked). Hit: the real read runs, then d0 = our value. */
ap_get:
 mov d0,d2
 mov d1,d3
 add -4,sp
 call ap_val,[d2,d3,a2],16
 add 4,sp
 cmp 1,d0
 bne 1f
 mov d2,d0
 mov d1,d2
 mov d3,d1
 mov 0,a0
 call ep7_getter,[d2,d3],12
 mov d2,d0
 ret [d2,d3],12
1:
 mov d2,d0
 mov d3,d1
 mov 0,a0
 jmp ep7_getter

/* ap_s: live view effective S read (0x6030bd5d, was mv_s): a3 = rec+704, rec+294 == 1 and AP -> P3 S, else mv_s with the site's registers */
ap_s:
 movbu (-410,a3),d2
 cmp 1,d2
 bne 1f
 mov d0,d2
 mov d1,d3
 add -4,sp
 call ap_val,[d2,d3,a2],16
 add 4,sp
 cmp 1,d0
 bne 2f
 mov d1,d0
 mov d3,d1
 ret [d2,d3],12
2:
 mov d2,d0
 mov d3,d1
 mov 0,a0
1:
 jmp ep7_mv_s

/* ap_tx: jmp at tbl_x: a0 = table, d3 = byte offset, frame [d2,d3],8. Keeps d0, d1, a1.
 * The pipeline always reads P's table, also while P2 or P3 is swapped into the state word (a wheel left open, or an SCP open that
 * ended without an init); COLOR4's row (192..255) in AP + Vivid -> a sanitised copy of P3's row at P3 +{san}: AP jobs never get
 * grain, glow / clarity, halation or Art Effects, whatever the slot holds. */
ap_tx:
 add -20,sp
 mov d0,(4,sp)
 mov d1,(8,sp)
 mov a0,(12,sp)
 mov a1,(16,sp)
 add -4,sp
 call ap_P,[d2],8
 add 4,sp
 cmp 1,d0
 bne 1f
 add 32,a0
 mov a0,(12,sp)
1:
 mov d3,d2
 add -192,d2
 cmp 64,d2
 bcc 3f
 add -4,sp
 call ap_on,[d2,d3,a2],16
 add 4,sp
 cmp 1,d0
 bne 3f
 mov a0,a1                        /* P3: a sanitised copy of its row at P3 +{san}: no grain, glow/clarity, halation or Art Effect */
 add 224,a1
 add {san},a0
 clr d1
4:
 movbu (d1,a1),d0
 movbu d0,(d1,a0)
 inc d1
 cmp 64,d1
 bne 4b
 clr d0
 movbu d0,(28,a0)                 /* effect id: bloom / halation / clarity */
 movbu d0,(29,a0)                 /* effect strength */
 movbu d0,(45,a0)                 /* bloom tint */
 movbu d0,(46,a0)                 /* Art Effect */
 movbu d0,(50,a0)                 /* Grain */
 mov 1,d0
 movbu d0,(52,a0)                 /* Halo: Off */
 add -192,a0
 mov a0,(12,sp)
 mov (16,sp),a1
 mov (4,sp),d0
 mov (8,sp),d1
 mov (12,sp),a0
 add 20,sp
 add d3,a0
 ret [d2,d3],8
3:
 mov (4,sp),d0
 mov (8,sp),d1
 mov (12,sp),a0
 mov (16,sp),a1
 add 20,sp
 add d3,a0
 ret [d2,d3],8

/* ap_key: jmp at 0x60316bfb (was mv_key): a0 = rec+292, a1 = rec; d2, a3 free. Record Vivid and AP -> key 11. */
ap_key:
 movbu (2,a0),d0
 cmp 1,d0
 bne 9f
 SAVE5
 add -4,sp
 call ap_on,[d2,d3,a2],16
 add 4,sp
 mov d0,d2
 REST5
 cmp 1,d2
 bne 9f
 mov 11,d0
 add 925,a1
 jmp ep7_key_ret
9:
 jmp ep7_mv_key

/* ap_msg: jmp at 0x60315900 (was sh_msg): d3 = rec+941, a1 = message. Record Vivid and AP -> message +20 = 4 (S valid). Only d0, a0 change. */
ap_msg:
 SAVE5
 mov d3,a0
 movbu (-647,a0),d0
 cmp 1,d0
 bne 8f
 add -4,sp
 call ap_on,[d2,d3,a2],16
 add 4,sp
 cmp 1,d0
 bne 8f
 REST5
 mov 4,d0
 mov 21,a0
 movbu d0,(20,a1)
 jmp ep7_msg_ret
8:
 REST5
 jmp ep7_sh_msg

/* ap_tb: lv / tone slot read (was mv_tbl), `call ...,[d2,d3],8`: d1 = mark (mv_prof forced COLOR4) and AP -> a0 = P3 row. Keeps d0, d1, a1. */
ap_tb:
 mov {pmark},d2
 cmp d2,d1
 bne 9f
 add -12,sp
 mov d0,(4,sp)
 mov a1,(8,sp)
 add -4,sp
 call ap_on,[d2,d3,a2],16
 add 4,sp
 mov d0,d2
 mov (4,sp),d0
 mov (8,sp),a1
 add 12,sp
 mov {pmark},d1
 cmp 1,d2
 bne 9f
 add 224,a0
 ret [d2,d3],8
9:
 jmp ep7_mv_tbl

/* ap_lc: jmp at 0x60e5951c (was mv_lc): row 111, GUI value 0 (Vivid), AP slot and AP -> swap to P3 (pending), stock route to key {ckey}. Else mv_lc.
 * Sid 1337 is not tested: stock blocks art variations with it in movie only, and AP is never movie. */
ap_lc:
 cmp 111,d3
 beq 1f
 jmp ep7_lc_no
1:
 mov (36,sp),d1
 cmp 0,d1
 bne 8f
 SAVE5
 add -4,sp
 call ap_mode,[d2,d3,a2],16
 add 4,sp
 cmp 1,d0
 bne 4f
 call ap_swap,[d2],8
 add 24,sp
 mov {ckey},d0
 jmp ep7_lc_open
4:
 REST5
8:
 jmp ep7_mv_lc

/* ap_swap: a0 = P3 -> state word = P3's handle, P3 +{pend} = 1 (the next COLOR editor init keeps the swap). `call ap_swap,[d2],8`. Uses d2, a0 */
ap_swap:
 mov 1,d2
 movbu d2,({pend},a0)
 mov a0,d2
 add {neg_pool},d2
 inc d2
 mov {state},a0
 movhu d2,(a0)
 ret [d2],8

/* ap_unswap: state word holds P3 -> P's handle, pending 0; d0 = 1 when it did. `call ap_unswap,[d2,d3,a2],16`. Uses d0, a0 (P2: movie's, untouched) */
ap_unswap:
 movhu ({state}),d2
 HV d2,a0,9f
 mov ({vm},a0),d2
 cmp {vmagic},d2
 bne 9f
 mov ({vp},a0),d2
 cmp a0,d2
 bne 9f
 mov a0,a2
 call ap_P,[d2],8
 cmp 1,d0
 bne 9f
 call ap_q,[d2],8
 cmp 1,d0
 bne 9f
 mov a2,d2
 cmp a0,d2
 bne 9f
 clr d0
 movbu d0,({pend},a0)
 mov ({vh},a0),d2
 mov {state},a0
 movhu d2,(a0)
 mov 1,d0
 ret [d2,d3,a2],16
9:
 clr d0
 ret [d2,d3,a2],16

/* ap_scr / ap_scr2: entries of the screen lookups 0x60e4cea8 / 0x60e4cf21 (d0 group, d1 key). In AP, pipeline mode 1, GUI 111 == 0 (Vivid), AP slot -> swap to P3
 * (pending), key {ckey}, for group 0x12 key {vkey} (sid 119, what OK on the SCP Saturation cell opens: fallback route) and for key 111 (the
 * picture-mode list) only while ap_sinfo armed it (INFO release on that cell). OK on the picture-mode cell opens the stock list. Then the stock entry, replayed. */
ap_scr:
 SAVE5
 call ap_sc,[d2,d3,a2],16
 REST5
 movhu d1,(32,sp)
 clr d1
 mov d1,(28,sp)
 jmp ep7_scr_resume

ap_scr2:
 SAVE5
 call ap_sc,[d2,d3,a2],16
 REST5
 mov a0,(28,sp)
 mov a1,d2
 movhu d2,(34,sp)
 jmp ep7_scr2_resume

ap_sc:                            /* d0 group, d1 key; the caller's saved d1 is at (24,sp) here: a new key goes there */
 cmp 0x12,d0
 bne 9f
 mov d1,d3
 exthu d3
 cmp {vkey},d3                    /* Saturation cell: OK opens the wheel (fallback route) */
 beq 1f
 cmp 111,d3                       /* picture-mode list: only when ap_sinfo armed it (INFO), so OK keeps the list */
 bne 9f
1:
 call ap_on,[d2,d3,a2],16
 cmp 1,d0
 bne 9f
 mov a0,a2
 cmp 111,d3
 bne 2f
 movbu ({arm},a2),d0
 cmp 1,d0
 bne 9f
 clr d0
 movbu d0,({arm},a2)
 bra 3f
2:
 add -4,sp
 mov 111,d0                       /* GUI picture mode: 0 = Vivid */
 call ep7_sget,[],4
 add 4,sp
 cmp 0,d0
 bne 9f
3:
 mov a2,a0
 call ap_swap,[d2],8
 mov {ckey},d0
 mov d0,(24,sp)
9:
 ret [d2,d3,a2],16

/* ap_sinfo: SsMenuLv handler word 24 (0x611a2c68). The machine's matrix is event-major (handler = word[matrix[event_index * 29 +
 * state - 1]], dispatcher 0x60d11448); handler 24 serves only (state 3 = the SCP, INFO release 0x9015) and cycles sid 281, which
 * leaves the SCP. d0 = event, d1 / a1 = arguments, return address at (0,sp).
 * Focused cell sid 111 (0x60e4d144 on the SCP holder 0x61fc4328), AP, pipeline mode 1, GUI 0 (Vivid), AP slot -> arm, key word 111,
 * rc (4,7), the rc DtlScp returns for OK: state 7 opens the lookup and ap_sc turns it into the wheel. Else the stock handler, registers as on entry. */
ap_sinfo:
 cmp {ev_info},d0
 bne 8f
 add -4,sp                        /* local: P3 at (24,sp) after SAVE5 */
 SAVE5
 add -4,sp
 call ap_on,[d2,d3,a2],16
 add 4,sp
 cmp 1,d0
 bne 7f
 mov a0,(24,sp)
 add -4,sp
 mov 111,d0
 call ep7_sget,[],4
 add 4,sp
 cmp 0,d0
 bne 7f
 add -4,sp
 mov ({scp_hold}),a0
 call ep7_cell,[],4
 add 4,sp
 exthu d0
 cmp 111,d0
 bne 7f
 mov {scp_key},a0
 movhu d0,(a0)
 mov (24,sp),a0
 mov 1,d0
 movbu d0,({arm},a0)
 REST5
 add 4,sp
 mov 0x407,d0
 add -4,sp
 ret [],4
7:
 REST5
 add 4,sp
8:
 jmp ep7_sc_rel

/* ap_init: COLOR1-4 parent records +4 (was po_init). A swap that this open didn't ask for (pending 0) is undone first, so a stills
 * editor never works on P3. Registers, MDR and the stack as on entry, then po_init. */
ap_init:
 SAVE5
 add -4,sp
 call ap_P,[d2],8
 add 4,sp
 cmp 1,d0
 bne 8f
 add -4,sp
 call ap_q,[d2],8
 add 4,sp
 cmp 1,d0
 bne 8f
 clr d0
 movbu d0,({arm},a0)              /* an arm never outlives an editor open */
 movbu ({pend},a0),d0
 cmp 1,d0
 bne 7f
 clr d0
 movbu d0,({pend},a0)             /* our open: keep the swap */
 bra 8f
7:
 add -4,sp
 call ap_unswap,[d2,d3,a2],16
 add 4,sp
8:
 REST5
 jmp ep7_po_init

/* ap_ccg: mv_get's `call mv_ccg,[],4` (keep the Color Creator switch off): AP slot and AP -> 1, else mv_ccg. Clobbers d0, d1, a0, a1. */
ap_ccg:
 add -4,sp
 call ap_mode,[d2,d3,a2],16
 add 4,sp
 cmp 1,d0
 bne 1f
 ret [],4
1:
 jmp ep7_mv_ccg

/* Labels: in front of mv_la / mv_lc2. String id 1657 ("Vivid"), kind 4, AP slot and AP -> mv_lb's own writer ("INFO Custom"). */
ap_la:
 call ap_lbl,[],4
 cmp 0,d0
 bne 1f
 jmp ep7_mv_la
1:
 mov d0,d1
 jmp ep7_ret_a

ap_lb2:
 call ap_lbl,[],4
 cmp 0,d0
 bne 1f
 jmp ep7_mv_lc2
1:
 mov d0,d1
 jmp ep7_ret_b

ap_lbl:                           /* -> d0 characters drawn, or 0 with d1, a0, a1 kept. Same frame as mv_lb, so its hit tail returns from here */
 movhu (a3),d0
 cmp 4,d0
 bne 8f
 movhu (2,a2),d0
 cmp 1657,d0
 beq 1f
 cmp 183,d0                       /* "Muted": movie's log mode */
 bne 8f
1:
 add -16,sp
 mov d1,(4,sp)
 mov a0,(8,sp)
 mov a1,(12,sp)
 movhu (2,a2),d0
 cmp 183,d0
 bne 2f
 jmp ap_wlog
2:
 add -4,sp
 call ap_mode,[d2,d3,a2],16
 add 4,sp
 cmp 1,d0
 bne ap_lr
 jmp ep7_lb_hit
ap_lr:
 mov (4,sp),d1
 mov (8,sp),a0
 mov (12,sp),a1
 add 16,sp
8:
 clr d0
 ret [],4

/* ap_pre: jmp from sd_back (was mv_trig; event at (16,sp)). Every half-press: a dirty P3 is saved as AP.BIN and its dirty byte cleared, so mv_trig never sees it. */
ap_pre:
 add -16,sp
 mov d0,(0,sp)
 mov d1,(4,sp)
 mov a0,(8,sp)
 mov a1,(12,sp)
 mov (32,sp),d0
 cmp {ev_press},d0
 bne 9f
 movm [d2,d3,a2,a3],(sp)
 add -4,sp
 call ap_boot,[d2,d3,a2],16      /* once per boot: stale marks, BUNDLES retry */
2:
 call ap_mode,[d2,d3,a2],16
 cmp 1,d0
 beq 1f
 call ap_unswap,[d2,d3,a2],16            /* off AP (or no slot): no AP wheel can be open */
1:
 call ap_P,[d2],8
 cmp 1,d0
 bne 8f
 call ap_q,[d2],8
 cmp 1,d0
 bne 8f
 mov a0,a2
 movbu ({dirty},a2),d0
 cmp 1,d0
 bne 8f
 clr d0
 movbu d0,({dirty},a2)
 call ap_save,[d2,d3,a2,a3],24
 movbu d0,({status},a2)
8:
 add 4,sp
 movm (sp),[d2,d3,a2,a3]
9:
 mov (0,sp),d0
 mov (4,sp),d1
 mov (8,sp),a0
 mov (12,sp),a1
 add 16,sp
 jmp ep7_mv_trig

/* ap_post: mv_trig's tail jmp (was ed_trig), same frame. First half-press, after mv_trig's film load and Movie slot load: AP.BIN, once per power-on. */
ap_post:
 add -16,sp
 mov d0,(0,sp)
 mov d1,(4,sp)
 mov a0,(8,sp)
 mov a1,(12,sp)
 mov (32,sp),d0
 cmp {ev_press},d0
 bne 9f
 movm [d2,d3,a2,a3],(sp)
 add -4,sp
 call ap_P,[d2],8
 cmp 1,d0
 bne 8f
 mov a0,a2
 mov ({vt},a2),d0                 /* mv_trig has run its first-press loads */
 cmp {vtmagic},d0
 bne 8f
 mov ({atr},a2),d0
 cmp {atmagic},d0
 beq 8f
 mov {atmagic},d0
 mov d0,({atr},a2)
 clr d0
 mov d0,({am},a2)
 call ap_load,[d2,d3,a2,a3],24
8:
 add 4,sp
 movm (sp),[d2,d3,a2,a3]
9:
 mov (0,sp),d0
 mov (4,sp),d1
 mov (8,sp),a0
 mov (12,sp),a1
 add 16,sp
 jmp ep7_trig

/* Extras on the Movie / AP slot: sectors 1 Grain, 2 Glow/Clarity, 5 Art, 11 Halo (COLOR4 ids 1655, 1656, 1659, 1665) read 0 and
 * ignore writes while a swapped slot (P2 or P3) is open on the X page (GetDefault is already 0 on X). In front of mv_get / mv_set; COLOR1-4 never match.
 * ap_xb: d0 = id -> d0 = 1 blocked, else 0. `call ap_xb,[d2,d3,a2],16`. Uses d0. */
ap_xb:
 mov d0,d2
 exthu d2
 add -1655,d2
 cmp 0,d2
 beq 1f
 cmp 1,d2
 beq 1f
 cmp 4,d2
 beq 1f
 cmp 10,d2
 bne 9f
1:
 movhu ({state}),d3
 HV d3,a2,9f
 mov ({vm},a2),d3
 cmp {vmagic},d3
 bne 9f
 mov ({vp},a2),d3
 cmp a2,d3
 bne 9f
 mov ({em},a2),d3
 cmp {emagic},d3
 bne 9f
 movbu ({axis},a2),d3
 cmp {x_axis},d3
 bne 9f
 mov 1,d0
 ret [d2,d3,a2],16
9:
 clr d0
 ret [d2,d3,a2],16


/* padding: patches/halation rewrites ap_load's zero check at a fixed address */
{pad}

/* ap_load: a2 = P. As mv_load, with AP.BIN and P3. Locals (4,sp) handle. The same range table as mv_load: +49..51 (lens, Grain, Sharp) and NR +24 are the readers' to check */
ap_load:
 mov 1024,d0
 call ep7_malloc,[],4
 cmp 0,a0
 beq l_out
 mov a0,a3
 mov a3,d0
 add {neg_pool},d0
 cmp {lim},d0
 bcc l_free
 btst 3,d0
 bne l_free
 clr d2
