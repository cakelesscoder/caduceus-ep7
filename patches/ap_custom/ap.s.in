 mov 1,d0
 mov 97,d1
 mov a2,a1
 call ep7_fread,[d2,d3,a2,a3],24
 mov d0,d3
 mov a2,a0
 call ep7_fclose,[d2,a2,a3],16
 cmp 96,d3
 bne 4f
