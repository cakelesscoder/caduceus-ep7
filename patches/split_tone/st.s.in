/* E-P7 1.1 split toning (ep7-firmware, our own code). docs/SPLIT_TONE.md.
 *
 * Port of the split-toning engine of Caduceus for OM-3 v0.26 (androidfanman/caduceus-om3, Apache-2.0: firmware/src/editor.s
 * st_run / st_k, research/splittone/model.py): the same formula and the same st_k table, so the numbers match
 * webapp/src/split.ts. NOTICE: split toning formula and st_k table from Caduceus for OM-3 v0.26 by androidfanman (Apache-2.0).
 *
 * Hook: the tone_ends hook 0x603b14ff `call tone,[d2,d3,a2,a3],72` (v0.19) now calls st. st pushes every register
 * (movm with `other`: d0, d1, a0, a1, MDR, LIR, LAR), works below that, pops them and leaves by `jmp tone`, so tone runs
 * on exactly the registers and stack it got before.
 * The RGB gamma selector 0x603ae80d (stage-list call 0x603b14a6, earlier on the same path) has written the three gamma
 * slots O+2596 / 2600 / 2604 (one ROM pointer, 256 x u16, 12-bit; docs/VIDEO_LOG.md bank A), or kept last pass's
 * pointers when nothing changed (skip path: C+108 bit 0 cleared). st points the slots at its own RAM curves:
 *   t' = t + ((Ks ws + Kh wh) >> 8), ws = ((t s >> 12) s) >> 12, wh = ((t t >> 12) s) >> 12, s = 4095 - t
 *   (t above 4095 read as 4095), clamped 0..4095, running max; K = st_k[colour][channel] x strength.
 * Slot bytes: +62 Shadows, +63 Highlights; low nibble colour 0..11, high nibble strength s4 -5..5. A field with colour
 * >= 12, strength 0 or strength outside -5..5 reads 0 (off).
 *
 * P = ap_P (the unswapped P). RAM: block S (malloc {sbytes} B: class 2, uncached), pointer at heap P+{sptr}, allocated on the first pass that has a
 * split. S+0 'EP7S', S+4 P; set k (0 capture, 1 live view) at S+{set0}+{setsz}k: +0 source curve, +4 word (+62 | +63 << 8),
 * +16 R, +528 G, +1040 B. A set is rebuilt only when its source or word changes; a pass whose slots already hold its
 * curve stores nothing.
 *
 * Order: P valid (SD loader v3 state; the loader only runs with all nine sections loaded) -> gamma on, slots: one of our
 * sets (base = that set's source) or one curve R = G = B (base = it), else leave them -> gates as tone (job guard,
 * key 11, capture marker + mode 11 + profile, or live view: a COLOR slot with +62/+63 != 0, then the getter 0xF6B1,
 * which is 0 in movie / AP Vivid) -> slot via tbl_idx -> word != 0 -> set k, slots = set k, C+108 bit 0 (gamma changed:
 * the register writer 0x60346eb4 copies the slots again). A miss with our curve in the slots puts base back in all
 * three (+ C+108 bit 0), so they are stock again.
 * Stores: the stack, S, P+{sptr}, O+2596..2607, C+108. mul with MDR restored by the pop.
 */
 .am33_2
 .section .sta,"ax"
 .global _start
_start:
st:                               /* call st,[d2,d3,a2,a3],72; d3 = context C */
 movm [d2,d3,a2,a3,other],(sp)
 add -52,sp                       /* (0,sp): calls store their return address there */
 call ep7_ap_p,[d2],8             /* -> d0 1, a0 = P (the unswapped block also while P2 / P3 is swapped in) */
 cmp 1,d0
 bne 9f
 mov a0,a1
 mov a1,(4,sp)                    /* P */
 mov d3,a2                        /* C */
 mov (12,a2),a3                   /* O */
 mov (4,a3),d0
 btst 0x1000,d0                   /* gamma off (0x603ae7ee) */
 bne 9f
 jmp st_b
9:
st_x:
 add 52,sp
 movm (sp),[d2,d3,a2,a3,other]
 jmp ep7_tone

 .section .stb,"ax"
st_b:                             /* a1 = P, a2 = C, a3 = O */
 mov (2596,a3),d0
 mov d0,(12,sp)                    /* base = R slot */
 mov ({sptr},a1),a0               /* S, checked */
 mov a0,d1
 add -{pool2},d1
 cmp {lim2},d1
 bcc 1f
 btst 3,d1
 bne 1f
 mov (a0),d1
 cmp {smagic},d1
 bne 1f
 mov (4,a0),d1
 cmp a1,d1
 beq 2f
1:
 mov 0,a0
2:
 mov a0,(8,sp)                    /* S or 0 */
 mov -1,d2                        /* cur */
 cmp 0,a0
 beq 4f
 mov a0,d1
 add {set0}+16,d1                 /* set 0 R */
 cmp d1,d0
 beq 3f
 add {setsz},d1                   /* set 1 R */
 cmp d1,d0
 bne 4f
 inc d2
3:
 inc d2
 add 512,d1
 mov (2600,a3),d3
 cmp d1,d3
 bne 9f
 add 512,d1
 mov (2604,a3),d3
 cmp d1,d3
 bne 9f
 add -1040,d1
 mov d1,a0
 mov (a0),d0
 mov d0,(12,sp)                    /* base = the curve the set replaced */
 bra 5f
4:
 cmp 0,d0
 beq 9f                           /* no gamma */
 mov (2600,a3),d1                 /* not ours: R = G = B, else leave them */
 cmp d1,d0
 bne 9f
 mov (2604,a3),d1
 cmp d1,d0
 bne 9f
5:
 mov d2,(16,sp)                   /* cur -1 / 0 / 1 */
 mov (4,a2),a1                    /* request R */
 mov (a1),d0
 cmp {callback},d0
 bne 8f
 mov (4,a1),d0                    /* R+4 -> selected record */
 mov a1,a0
 add {rec_off},a0
 mov {n_rec},d2
6:
 cmp a0,d0
 beq 7f
 add {stride},a0
 add -1,d2
 bne 6b
 bra 8f
7:
 mov (a0),d1                      /* record+0 = parent job */
 mov a1,a0
 add -{req_in_job},a0             /* a0 = job */
 cmp a0,d1
 bne 8f
 mov (8,a1),d0
 cmp 0xb0000,d0                   /* key 11 (COLOR) */
 bne 8f
 jmp st_g
8:
 jmp st_m
9:
 jmp st_x

 .section .stg,"ax"
st_g:                             /* a0 = job */
 clr d3                           /* kind 0: capture */
 movbu ({ext_magic},a0),d0
 cmp {magic},d0
 bne 1f
 movbu ({ext_mode},a0),d0
 cmp 11,d0
 bne 8f
 movbu ({ext_profile},a0),d0
 bra 3f
1:
 mov {prop_profile},d0            /* live view */
 clr d1
 mov 0,a0
 call ep7_getter,[d2,d3],12       /* d0 = effective COLOR profile (0 in movie / AP Vivid) */
 inc d3                           /* kind 1: live view */
3:
 add -1,d0
 cmp 4,d0
 bcc 8f
 mov d3,(24,sp)
 call ep7_tbl_idx,[d2,d3],8       /* a0 = slot (AP: the sanitised row, as tone) */
 add {sb},a0
 clr d2                           /* word */
 clr d3                           /* shift */
4:
 movbu (a0),d0
 mov d0,d1
 and 15,d1
 cmp 12,d1
 bcc 5f                           /* no such colour */
 mov d0,d1
 lsr 4,d1
 add 5,d1
 and 15,d1                        /* strength + 5, mod 16 */
 cmp 5,d1
 beq 5f                           /* strength 0 */
 cmp 11,d1
 bcc 5f                           /* outside -5..5 */
 asl d3,d0
 or d0,d2
5:
 inc a0
 add 8,d3
 cmp 16,d3
 bne 4b
 cmp 0,d2
 beq 8f
 mov d2,(20,sp)
 jmp st_c
8:
 jmp st_m

 .section .stc,"ax"
st_c:
 mov (8,sp),a1
 cmp 0,a1
 bne 1f
 mov {sbytes},d0
 call ep7_malloc,[],4             /* -> a0 (uncached class-2 pool) or 0 */
 mov a0,a1
 mov a1,d1
 add -{pool2},d1
 cmp {lim2},d1
 bcc 3f                           /* 0, or not where the check looks */
 btst 3,d1
 bne 3f
 mov {smagic},d0
 mov d0,(a1)
 mov (4,sp),a0
 mov a0,(4,a1)
 mov -1,d0
 mov d0,({set0}+4,a1)             /* no word is -1 */
 mov d0,({set0}+{setsz}+4,a1)
 mov a1,({sptr},a0)               /* publish */
1:
 add {set0},a1
 mov (24,sp),d3
 cmp 0,d3
 beq 2f
 add {setsz},a1
2:
 mov a1,(28,sp)                   /* set k */
 jmp st_e
3:
 cmp 0,a1
 beq 4f
 mov a1,a0
 call ep7_free,[],4
4:
 jmp st_x

 .section .std,"ax"
st_e:                             /* a1 = set k, d3 = k */
 mov (4,a1),d0
 mov (20,sp),d1
 cmp d1,d0
 bne 1f
 mov (a1),d0
 mov (12,sp),d1
 cmp d1,d0
 bne 1f                           /* set k holds another curve: rebuild */
 mov (16,sp),d0
 cmp d3,d0
 bne st_pub                       /* built: point the slots at it */
 jmp st_x                         /* built and in the slots: nothing */
1:
 mov (12,sp),d0
 mov d0,(a1)                      /* set: source (word last, after the curve) */
 clr d0
 mov d0,(32,sp)                   /* channel */
 jmp st_ch
st_pub:
 mov (28,sp),a1
 mov (20,sp),d0
 mov d0,(4,a1)                    /* set: word */
 mov a1,d0
 add 16,d0
 mov d0,(2596,a3)                 /* the slots: set k */
 add 512,d0
 mov d0,(2600,a3)
 add 512,d0
 mov d0,(2604,a3)
 jmp st_d

 .section .ste,"ax"
st_ch:                            /* d0 = channel */
 movbu (20,sp),d1                 /* Shadows field */
 call st_kv,[],4
 mov d1,(36,sp)                   /* Ks */
 mov (32,sp),d0
 movbu (21,sp),d1                 /* Highlights field */
 call st_kv,[],4
 mov d1,(40,sp)                   /* Kh */
 mov (12,sp),a0                    /* source */
 mov (32,sp),d0
 asl 9,d0
 mov (28,sp),a1
 add 16,a1
 add d0,a1                        /* this channel's curve */
 mov a1,d0
 add 512,d0
 mov d0,(48,sp)                   /* its end */
 clr d0
 mov d0,(44,sp)                   /* running max */
1:
 movhu (a0),d0                    /* t */
 cmp 4095,d0
 bls 2f
 mov 4095,d0
2:
 mov 4095,d1
 sub d0,d1                        /* s */
 mov d0,d2
 mul d1,d2
 lsr 12,d2
 mul d1,d2
 lsr 12,d2                        /* ws */
 mov (36,sp),d3
 mul d3,d2                        /* Ks ws */
 mov d0,d3
 mul d0,d3
 lsr 12,d3
 mul d1,d3
 lsr 12,d3                        /* wh */
 mov (40,sp),d1
 mul d1,d3                        /* Kh wh */
 add d3,d2
 asr 8,d2
 add d2,d0
 bge 3f
 clr d0
3:
 cmp 4095,d0
 ble 4f
 mov 4095,d0
4:
 mov (44,sp),d1
 cmp d1,d0
 bge 5f
 mov d1,d0                        /* keep it rising */
5:
 mov d0,(44,sp)
 movhu d0,(a1)
 add 2,a0
 add 2,a1
 mov (48,sp),d1
 cmp d1,a1
 bne 1b
 mov (32,sp),d0
 inc d0
 mov d0,(32,sp)
 cmp 3,d0
 bne st_ch
 jmp st_pub

/* st_kv: d0 = channel, d1 = field byte -> d1 = st_k[colour][channel] x strength. Uses a0, d2. */
st_kv:
 mov d1,d2
 and 15,d1
 mov d1,a0
 add d1,a0
 add d1,a0
 add d0,a0
 add st_k,a0
 movbu (a0),d1
 extb d1
 asl 24,d2
 asr 28,d2                        /* strength, sign-extended */
 mul d2,d1
 ret [],4

 .section .stf,"ax"
st_m:                             /* miss: our curve in the slots -> the base again */
 mov (16,sp),d0
 cmp 0,d0
 bge 1f
 jmp st_x
1:
 mov (12,sp),d0
 mov d0,(2596,a3)
 mov d0,(2600,a3)
 mov d0,(2604,a3)
st_d:
 mov (108,a2),d0                  /* C+108 bit 0: gamma changed */
 or 1,d0
 mov d0,(108,a2)
 jmp st_x
 .balign 4
st_k:                             /* Caduceus for OM-3 v0.26 st_k: K per strength step, R G B, the wheel's 12 colours */
 .byte 7,7,-57                    /* Yellow */
 .byte 26,-4,-47                  /* Orange */
 .byte 37,-12,-33                 /* Orange-red */
 .byte 43,-18,-18                 /* Red */
 .byte 39,-26,29                  /* Magenta */
 .byte 17,-19,53                  /* Violet */
 .byte -11,-5,56                  /* Blue */
 .byte -33,9,39                   /* Blue-cyan */
 .byte -43,18,18                  /* Cyan */
 .byte -45,24,-5                  /* Green-cyan */
 .byte -36,25,-36                 /* Green */
 .byte -13,17,-55                 /* Yellow-green */
st_end:
