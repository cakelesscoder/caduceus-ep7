# Vendor firmware: never commit (OM EULA forbids redistribution). Hashes only.
*.BIN
*.bin
stock_firmware/*
!stock_firmware/SHA256SUMS
# Generated analysis / build output (reproducible from scripts)
generated/
analysis/
toolchains/
__pycache__/
*.pyc
.venv/
testdata/

# User-side builder output; card files of releases are our own data (not OM firmware)
out/
!releases/**/card/*/*.BIN
!releases/v*/card/EP7MOD/*.BIN

# one-press builder output + cached OM download (never commit)
cache/
Caduceus-v*/

# Private RE material (docs/RE_PRIVATE.md)
*.gpr
*.rep/
*.decomp.c
ep7fw-private/
